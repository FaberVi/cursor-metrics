# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows scripts keep CRLF when checked out on Windows.
*.{cmd,bat} text eol=crlf

# Binary assets — do not modify line endings.
*.{png,jpg,jpeg,gif,webp,ico,svg} -text
*.{woff,woff2,ttf,eot} -text
*.{vsix,zip,gz,sqlite} -text
*.{pdf,exe,dll,so,dylib} -text

# Lockfiles and generated bundles: treat as text with LF.
bun.lock linguist-generated=false
package-lock.json linguist-generated=false
